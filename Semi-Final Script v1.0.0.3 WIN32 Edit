#Requires -RunAsAdministrator
<#
Windows 11 Vulnerable Lab Security Audit Script
Purpose: Audit (ONLY) a deliberately vulnerable Windows 11 system
         and provide detailed remediation advice
Version:  1.0 - educational/lab usage (2026 style)
Usage:    Right-click → Run with PowerShell   or   powershell.exe -ExecutionPolicy Bypass -File .\win11-lab-audit.ps1 | Tee-Object -FilePath audit-report-$(Get-Date -Format "yyyyMMdd").txt
#>

# ────────────────────────────────────────────────
# Colors & output helpers
# ────────────────────────────────────────────────
$RED    = "$([char]0x1b)[31m"
$GREEN  = "$([char]0x1b)[32m"
$YELLOW = "$([char]0x1b)[33;1m"
$BLUE   = "$([char]0x1b)[34m"
$CYAN   = "$([char]0x1b)[36m"
$NC     = "$([char]0x1b)[0m"

function Print-Header {
    param([string]$Text)
    Write-Host "`n$BLUE════════════════════════════════════════════════════════════$NC"
    Write-Host "$BLUE $Text $NC"
    Write-Host "$BLUE════════════════════════════════════════════════════════════$NC`n"
}

function PASS($msg)    { Write-Host "[${GREEN}PASS${NC}] $msg" }
function WARN($msg)    { Write-Host "[${YELLOW}WARN${NC}] $msg" }
function FAIL($msg)    { Write-Host "[${RED}FAIL${NC}] $msg" }
function INFO($msg)    { Write-Host "[${CYAN}INFO${NC}] $msg" }
function REC($msg)     { Write-Host "   → Recommendation: $msg" }

# ────────────────────────────────────────────────
# 0. System Information
# ────────────────────────────────────────────────
Print-Header "SYSTEM INFORMATION"

INFO "Hostname          : $env:COMPUTERNAME"
INFO "OS Version        : $([System.Environment]::OSVersion.VersionString)"
INFO "Build             : $((Get-ComputerInfo).WindowsBuildLabEx)"
INFO "Uptime            : $((Get-Date) - (Get-CimInstance Win32_OperatingSystem).LastBootUpTime)"
INFO "Current User      : $env:USERNAME (Admin: $([bool]([Security.Principal.WindowsIdentity]::GetCurrent()).Groups -match 'S-1-5-32-544'))"
if (-not ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    FAIL "Script not running elevated → many checks incomplete"
    REC "Right-click → Run with PowerShell (as Administrator)"
}

# ────────────────────────────────────────────────
# 1. Users & Groups
# ────────────────────────────────────────────────
Print-Header "USER & GROUP AUDIT"

# Local admins (besides default Administrator)
$admins = Get-LocalGroupMember -Group "Administrators" | Select -ExpandProperty Name
foreach ($admin in $admins) {
    if ($admin -notmatch "Administrator$|NT AUTHORITY\\SYSTEM") {
        WARN "Extra local admin: $admin"
        REC "Remove unnecessary admins: Remove-LocalGroupMember -Group 'Administrators' -Member 'username'"
    }
}

# Accounts with blank/empty password (very rare on modern Win11 but possible in labs)
# Note: Win11 usually prevents blank passwords unless policy allows
$blankPassPolicy = Get-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Lsa" -Name "LimitBlankPasswordUse" -ErrorAction SilentlyContinue
if ($blankPassPolicy -and $blankPassPolicy.LimitBlankPasswordUse -eq 0) {
    WARN "Blank password logon allowed over network"
    REC "Set LimitBlankPasswordUse = 1 in registry"
}

# ────────────────────────────────────────────────
# 2. Critical Permissions (Files & Registry)
# ────────────────────────────────────────────────
Print-Header "CRITICAL PERMISSIONS"

$criticalPaths = @(
    "$env:SystemRoot\System32\config\SAM",
    "$env:SystemRoot\System32\config\SYSTEM",
    "$env:SystemRoot\System32\config\SECURITY"
)

foreach ($path in $criticalPaths) {
    if (Test-Path $path) {
        $acl = Get-Acl $path
        $everyone = $acl.Access | Where-Object { $_.IdentityReference -eq "Everyone" -and $_.FileSystemRights -match "Read" }
        if ($everyone) {
            FAIL "$path is readable by Everyone"
            REC "Restrict ACL: icacls '$path' /inheritance:r /grant:r Administrators:F SYSTEM:F"
        }
    }
}

# World-writable temp folders check (common in labs)
$tempDirs = @("$env:TEMP", "$env:ALLUSERSPROFILE\Temp", "$env:SystemRoot\Temp")
foreach ($dir in $tempDirs) {
    if (Test-Path $dir) {
        $acl = Get-Acl $dir
        if ($acl.Access | Where-Object { $_.IdentityReference -eq "Everyone" -and $_.FileSystemRights -match "Modify|FullControl" }) {
            WARN "$dir allows Everyone write/modify"
            REC "Reset ACL: icacls '$dir' /inheritance:r /grant:r Administrators:F SYSTEM:F /grant 'Users':(OI)(CI)RX"
        }
    }
}

# ────────────────────────────────────────────────
# 3. Windows Firewall & Network
# ────────────────────────────────────────────────
Print-Header "FIREWALL & NETWORK"

$fwProfile = Get-NetFirewallProfile -PolicyStore ActiveStore
foreach ($profile in $fwProfile) {
    if ($profile.Enabled -eq $false) {
        FAIL "Firewall profile $($profile.Name) is DISABLED"
        REC "Enable-NetFirewallProfile -Profile $($profile.Name)"
    }
}

INFO "Listening ports (non-loopback):"
Get-NetTCPConnection -State Listen | Where-Object { $_.LocalAddress -notmatch "^(127\.0\.0\.1|::1)$" } |
    Select LocalAddress, LocalPort, OwningProcess | Format-Table -AutoSize

# ────────────────────────────────────────────────
# 4. Services
# ────────────────────────────────────────────────
Print-Header "SERVICES AUDIT"

# Dangerous/unneeded services often enabled in labs
$badServices = @("Telnet", "FTPSVC", "W3SVC", "Xbl*", "Xbox*")
Get-Service | Where-Object { $_.Name -in $badServices -or $_.DisplayName -match "Telnet|FTP|Web Server|Xbox" } | ForEach-Object {
    if ($_.Status -eq "Running") {
        WARN "Potentially dangerous service running: $($_.DisplayName) ($($_.Name))"
        REC "Stop-Service $($_.Name) -Force; Set-Service $($_.Name) -StartupType Disabled"
    }
}

# ────────────────────────────────────────────────
# 5. Running Processes Audit
# ────────────────────────────────────────────────
Print-Header "RUNNING PROCESSES AUDIT"

$suspiciousNames = "xmrig|kinsing|miner|crypto|nc\.exe|netcat|socat|powershell.*-nop.*-w hidden|cmd.*\/c.*http"

Get-Process | Where-Object { $_.ProcessName -match $suspiciousNames -or $_.Path -match $suspiciousNames } | ForEach-Object {
    WARN "Suspicious process: $($_.ProcessName) (PID: $($_.Id)) Path: $($_.Path)"
    REC "Investigate: Get-Process -Id $($_.Id) | Select * ; Stop-Process -Id $($_.Id) -Force (after confirmation)"
}

# Processes from temp folders
Get-Process | Where-Object { $_.Path -match "\\Temp|\\AppData\\Local\\Temp|\\Windows\\Temp" -and $_.Path -notmatch "OneDrive|Microsoft" } | ForEach-Object {
    WARN "Process running from temp dir: $($_.ProcessName) → $($_.Path)"
    REC "Check file origin: Get-Item '$($_.Path)' | Select *"
}

# High CPU processes
INFO "Top CPU consumers:"
Get-Process | Sort-Object CPU -Descending | Select -First 10 | Format-Table Name, Id, CPU, WorkingSet64 -AutoSize

# ────────────────────────────────────────────────
# 6. Scheduled Tasks (Windows equivalent of cron)
# ────────────────────────────────────────────────
Print-Header "SCHEDULED TASKS AUDIT"

$suspiciousTasks = Get-ScheduledTask | Where-Object { $_.TaskPath -notmatch "\\Microsoft\\" -or $_.Actions.Execute -match "powershell|cmd|curl|wget|bitsadmin" }

foreach ($task in $suspiciousTasks) {
    WARN "Non-Microsoft / suspicious task: $($task.TaskName) in $($task.TaskPath)"
    INFO "Action: $($task.Actions.Execute) $($task.Actions.Arguments)"
    REC "Review: Get-ScheduledTask '$($task.TaskName)' | Get-ScheduledTaskInfo ; Disable-ScheduledTask if malicious"
}

# ────────────────────────────────────────────────
# 7. Suspicious Files / Scripts
# ────────────────────────────────────────────────
Print-Header "SUSPICIOUS FILES / SCRIPTS"

$suspectDirs = @("$env:TEMP", "$env:ALLUSERSPROFILE\Temp", "$env:SystemRoot\Temp", "$env:USERPROFILE\Downloads", "$env:PUBLIC")

$suspiciousPatterns = @("*.ps1", "*.bat", "*.vbs", "*.exe", "*xmrig*", "*kinsing*", "*shell*", "*reverse*", "*backdoor*")

foreach ($dir in $suspectDirs) {
    if (Test-Path $dir) {
        Get-ChildItem -Path $dir -Recurse -File -ErrorAction SilentlyContinue |
            Where-Object { $_.Name -match ($suspiciousPatterns -join "|") } |
            Select -First 10 | ForEach-Object {
                FAIL "Suspicious file: $($_.FullName)"
                REC "Inspect: Get-Content '$($_.FullName)' -Head 15 ; Remove-Item if malicious (backup first)"
            }
    }
}

# ────────────────────────────────────────────────
# 8. Defender / Updates / Misc
# ────────────────────────────────────────────────
Print-Header "DEFENDER / UPDATES / MISC"

$defender = Get-MpComputerStatus
if ($defender.AntivirusEnabled -eq $false) {
    FAIL "Windows Defender Antivirus is DISABLED"
    REC "Set-MpPreference -DisableRealtimeMonitoring $false"
}

$updates = Get-WUHistory -Last 30
if ($updates.Count -eq 0) {
    WARN "No Windows Updates in last 30 days"
    REC "Check for updates: Install-Module PSWindowsUpdate ; Get-WUList"
}

# SMBv1 (very common vuln in labs)
if (Get-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -ErrorAction SilentlyContinue | Where-Object State -eq Enabled) {
    FAIL "SMBv1 enabled — highly vulnerable"
    REC "Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol"
}

# ────────────────────────────────────────────────
# SUMMARY
# ────────────────────────────────────────────────
Print-Header "SUMMARY & NEXT STEPS"

INFO "This script is intentionally noisy — expect many [WARN]/[FAIL] in a vulnerable lab."
INFO "Top remediation priorities:"

@"
  1. Enable & configure Windows Firewall properly
  2. Remove extra local Administrators
  3. Disable dangerous services (Telnet, FTP, SMBv1, etc.)
  4. Investigate suspicious processes & scheduled tasks
  5. Delete/analyze suspicious files in Temp/Downloads
  6. Enable Windows Defender real-time protection
  7. Install latest cumulative updates
  8. Consider enabling LAPS, BitLocker, AppLocker, etc.
"@

Write-Host "`n$GREEN Audit complete. Review output carefully and harden step-by-step.$NC"
Write-Host "Additional tools (if installed):"
Write-Host "  • Invoke-CISBenchmark (community scripts)"
Write-Host "  • Microsoft Baseline Security Analyzer (legacy)"
Write-Host "  • Windows Admin Center / Intune for enterprise"
Write-Host "  • Get-ComputerInfo | Select * for deeper info"

Write-Host "`n$CYAN Happy (ethical) hacking & good luck with your Windows 11 lab assessment!$NC"
